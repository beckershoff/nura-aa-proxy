# aa-proxy-rs renders this into /run/hostapd.conf (aa-proxy-rs --generate-hostapd).
# eqs: own AP interface ap0 next to wlan0 (WCN6855 allows STA + AP), WPA2-CCMP only.
ctrl_interface=/run/hostapd
interface=ap0
driver=nl80211
hw_mode={{HW_MODE}}
ieee80211be={{BE_MODE}}
ieee80211ax={{AX_MODE}}
ieee80211ac={{AC_MODE}}
ieee80211n={{N_MODE}}
wmm_enabled=1
channel={{CHANNEL}}
auth_algs=1
wpa=2
wpa_key_mgmt=WPA-PSK
rsn_pairwise=CCMP
ssid={{SSID}}
wpa_passphrase={{WPA_PASSPHRASE}}
country_code={{COUNTRY_CODE}}
ieee80211d=1
