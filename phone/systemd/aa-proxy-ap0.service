[Unit]
Description=aa-proxy car mode: ap0 access point interface
PartOf=aa-proxy.target
Before=aa-proxy-hostapd.service aa-proxy-dnsmasq.service

[Service]
Type=oneshot
RemainAfterExit=yes
# clear any stale "phone connected" flag from a previous run
ExecStartPre=/bin/sh -c 'rm -f /run/aa-proxy-phone-connected /run/aa-proxy-screen.saved'
ExecStart=/usr/local/libexec/aa-proxy-ap0 up
ExecStop=/usr/local/libexec/aa-proxy-ap0 down
# car mode off (this oneshot stops LAST, after aa-proxy-rs has freed the USB
# controller): restore the panel + flag, and rebuild postmarketOS USB networking
# (usb0 / 172.16.42.1) that aa-proxy-rs took over — so the phone is normal again
# with no replug or reboot.
ExecStopPost=/bin/sh -c 'rm -f /run/aa-proxy-phone-connected'
ExecStopPost=/usr/local/libexec/aa-proxy-screen on
ExecStopPost=/bin/sh -c 'systemctl --no-block restart usb-signaller.service'
