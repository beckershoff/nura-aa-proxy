#!/bin/sh
# aa-proxy-ctl - the single privileged entry point for the Car mode panel.
# Invoked as: sudo -n /usr/local/bin/aa-proxy-ctl <verb> [args]. Every verb
# validates its own input, so it is safe to expose via a NOPASSWD sudoers rule.
set -eu
SC=/usr/sbin/systemctl
CONF=/etc/aa-proxy-rs/car-mode.conf
AACONF=/etc/aa-proxy-rs/config.toml
die() { echo "aa-proxy-ctl: $*" >&2; exit 1; }

set_kv_conf() { # file KEY VALUE   (KEY=VALUE lines)
	f=$1 k=$2 v=$3; touch "$f"
	if grep -qE "^$k=" "$f"; then sed -i "s|^$k=.*|$k=$v|" "$f"
	else printf '%s=%s\n' "$k" "$v" >> "$f"; fi
}
set_kv_toml() { # KEY VALUE   (key = value lines, value written raw)
	k=$1 v=$2
	if grep -qE "^$k[[:space:]]*=" "$AACONF"; then sed -i "s|^$k[[:space:]]*=.*|$k = $v|" "$AACONF"
	else printf '%s = %s\n' "$k" "$v" >> "$AACONF"; fi
}

cmd=${1:-}; [ $# -gt 0 ] && shift || true
case "$cmd" in
	start)   exec $SC start aa-proxy.target ;;
	stop)    exec $SC stop aa-proxy.target ;;
	restart) $SC stop aa-proxy.target; exec $SC start aa-proxy.target ;;
	toggle)  if $SC is-active --quiet aa-proxy.target; then exec $SC stop aa-proxy.target
	         else exec $SC start aa-proxy.target; fi ;;
	set-conf)
		k=${1:-}; v=${2:-}
		case "$k" in
			BLANK_ON_CONNECT) case "$v" in 0|1) ;; *) die "bad value" ;; esac ;;
			IDLE_STOP_MIN) case "$v" in ''|*[!0-9]*) die "bad int" ;; esac
				[ "$v" -ge 1 ] && [ "$v" -le 180 ] || die "out of range" ;;
			*) die "key not allowed: $k" ;;
		esac
		set_kv_conf "$CONF" "$k" "$v" ;;
	set-aa)
		k=${1:-}; v=${2:-}
		case "$k" in
			mitm|ev|debug) case "$v" in true|false) ;; *) die "bad bool" ;; esac ;;
			dpi) case "$v" in ''|*[!0-9]*) die "bad int" ;; esac
				[ "$v" -ge 0 ] && [ "$v" -le 400 ] || die "out of range" ;;
			*) die "key not allowed: $k" ;;
		esac
		set_kv_toml "$k" "$v"
		$SC is-active --quiet aa-proxy-rs.service && $SC restart aa-proxy-rs.service || true ;;
	get-state)
		s=$(sed -n 's/^ssid[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "$AACONF" | head -1)
		p=$(sed -n 's/^wpa_passphrase[[:space:]]*=[[:space:]]*"\(.*\)"/\1/p' "$AACONF" | head -1)
		m=$(sed -n 's/^mitm[[:space:]]*=[[:space:]]*\(true\|false\).*/\1/p' "$AACONF" | head -1)
		e=$(sed -n 's/^ev[[:space:]]*=[[:space:]]*\(true\|false\).*/\1/p' "$AACONF" | head -1)
		d=$(sed -n 's/^dpi[[:space:]]*=[[:space:]]*\([0-9]*\).*/\1/p' "$AACONF" | head -1)
		g=$(sed -n 's/^debug[[:space:]]*=[[:space:]]*\(true\|false\).*/\1/p' "$AACONF" | head -1)
		b=$(sed -n 's/^BLANK_ON_CONNECT=\(.*\)/\1/p' "$CONF" 2>/dev/null | head -1)
		i=$(sed -n 's/^IDLE_STOP_MIN=\(.*\)/\1/p' "$CONF" 2>/dev/null | head -1)
		printf 'SSID\t%s\nPASS\t%s\nMITM\t%s\nEV\t%s\nDPI\t%s\nDEBUG\t%s\nBLANK\t%s\nIDLE\t%s\n' \
			"$s" "$p" "${m:-false}" "${e:-false}" "${d:-0}" "${g:-false}" "${b:-1}" "${i:-5}" ;;
	log)
		n=${1:-250}; case "$n" in ''|*[!0-9]*) n=250 ;; esac
		[ "$n" -gt 3000 ] && n=3000
		tail -n "$n" /var/log/aa-proxy-rs.log 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' ;;
	save-log)
		u=$(stat -c %U "/proc/$(pgrep -x phosh | head -1)" 2>/dev/null); u=${u:-user}
		home=$(awk -F: -v u="$u" '$1==u{print $6}' /etc/passwd); home=${home:-/home/$u}
		ts=$(date +%Y%m%d-%H%M%S); out="$home/aa-proxy-log-$ts.txt"
		sed 's/\x1b\[[0-9;]*m//g' /var/log/aa-proxy-rs.log > "$out" 2>/dev/null || die "no log"
		chown "$u" "$out" 2>/dev/null || true
		echo "$out" ;;
	*) die "usage: start|stop|restart|toggle|set-conf K V|set-aa K V|get-state|log [N]|save-log" ;;
esac
